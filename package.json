{
  "name": "rice-registry-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "web",
    "app",
    "cli"
  ],
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "oxlint && oxfmt --check"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "oxfmt": "^0",
    "oxlint": "^1",
    "tailwindcss": "^4"
  }
}
